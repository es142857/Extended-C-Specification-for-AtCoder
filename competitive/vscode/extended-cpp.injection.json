{
    "scopeName": "extended-cpp.additional",
    "injectionSelector": "L:source.cpp -comment -string",
    "patterns": [
        {
            "name": "invalid.illegal.solve-separator.ecpp",
            "match": "^[ \\t]*---[ \\t]*$"
        },
        {
            "name": "meta.function.extension.ecpp",
            "match": "^([ \\t]*)(?:(template[ \\t]*<[^>\\r\\n]*>)([ \\t]*))?([A-Za-z_~][\\w:<>,*& \\t]*)([ \\t]+)([A-Za-z_]\\w*(?:::[A-Za-z_]\\w*)*(?:[ \\t]*<[^>\\r\\n]*>)?)([ \\t]*)(\\.)([ \\t]*)([A-Za-z_]\\w*)(?=[ \\t]*\\([^\\r\\n]*\\)[ \\t]*(?:const[ \\t]*)?\\{)",
            "captures": {
                "2": { "name": "storage.type.template.cpp" },
                "4": { "name": "storage.type.cpp" },
                "6": { "name": "storage.type.cpp" },
                "8": { "name": "punctuation.accessor.cpp" },
                "10": { "name": "entity.name.function.definition.cpp" }
            }
        },
        {
            "name": "meta.control.for.ecpp",
            "begin": "(?:(;)|(?=^[ \\t]*))([ \\t]*)(for)([ \\t]*)(\\()(?=[ \\t]*\\[)",
            "beginCaptures": {
                "1": { "name": "punctuation.terminator.statement.cpp" },
                "3": { "name": "keyword.control.for.cpp" },
                "5": { "name": "punctuation.section.parens.begin.bracket.round.cpp" }
            },
            "end": "\\)",
            "endCaptures": {
                "0": { "name": "punctuation.section.parens.end.bracket.round.cpp" }
            },
            "patterns": [
                { "include": "#structured-binding" },
                { "include": "source.cpp#evaluation_context" }
            ]
        },
        {
            "name": "meta.sequence.list.ecpp",
            "begin": "(?<![\\w)\\]}])\\[(?=[^\\]\\r\\n]*\\](?![ \\t]*(?:[=:]|\\(|\\{|mutable\\b|constexpr\\b|consteval\\b|static\\b|noexcept\\b|->)))",
            "beginCaptures": {
                "0": { "name": "punctuation.section.brackets.begin.cpp" }
            },
            "end": "\\]",
            "endCaptures": {
                "0": { "name": "punctuation.section.brackets.end.cpp" }
            },
            "patterns": [
                { "include": "#list-content" }
            ]
        },
        {
            "name": "storage.type.template.cpp",
            "match": "\\badditional\\b"
        },
        {
            "name": "storage.type.primitive.cpp storage.type.built-in.primitive.cpp",
            "match": "\\blet\\b"
        }
    ],
    "repository": {
        "structured-binding": {
            "name": "meta.binding.structured.ecpp",
            "begin": "\\[",
            "beginCaptures": {
                "0": { "name": "punctuation.section.brackets.begin.cpp" }
            },
            "end": "\\]",
            "endCaptures": {
                "0": { "name": "punctuation.section.brackets.end.cpp" }
            },
            "patterns": [
                {
                    "name": "variable.other.readwrite.cpp",
                    "match": "\\b[A-Za-z_]\\w*\\b"
                },
                {
                    "name": "punctuation.separator.delimiter.comma.cpp",
                    "match": ","
                }
            ]
        },
        "nested-square-brackets": {
            "begin": "\\[",
            "beginCaptures": {
                "0": { "name": "punctuation.section.brackets.begin.cpp" }
            },
            "end": "\\]",
            "endCaptures": {
                "0": { "name": "punctuation.section.brackets.end.cpp" }
            },
            "patterns": [
                { "include": "#list-content" }
            ]
        },
        "list-content": {
            "patterns": [
                { "include": "#nested-square-brackets" },
                {
                    "name": "string.quoted.double.cpp",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        { "name": "constant.character.escape.cpp", "match": "\\\\." }
                    ]
                },
                {
                    "name": "string.quoted.single.cpp",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        { "name": "constant.character.escape.cpp", "match": "\\\\." }
                    ]
                },
                {
                    "name": "constant.numeric.cpp",
                    "match": "(?<![\\w.])(?:0[xX][0-9A-Fa-f']+|0[bB][01']+|(?:[0-9][0-9']*)(?:\\.[0-9']*)?)(?:[eE][+-]?[0-9']+)?[uUlLfF]*(?!\\w)"
                },
                {
                    "name": "constant.language.cpp",
                    "match": "\\b(?:true|false|nullptr)\\b"
                },
                {
                    "name": "keyword.operator.cpp",
                    "match": "(?:<<=?|>>=?|<=>|==|!=|<=|>=|&&|\\|\\||\\+\\+|--|->\\*?|\\.\\*|[+*/%&|^~!<>?:=-])"
                },
                {
                    "name": "variable.other.cpp",
                    "match": "\\b[A-Za-z_]\\w*\\b"
                },
                {
                    "name": "punctuation.separator.delimiter.comma.cpp",
                    "match": ","
                }
            ]
        }
    }
}
