void Yes(bool f){print(f?"Yes":"No");}void No(bool f){print(f?"No":"Yes");}template<typename S>S lcm(S a,S b){return(a/gcd(a,b))*b;}template<typename T>vec<T>dedupe(vec<T>x){sort(all(x));x.erase(unique(all(x)),x.end());return x;}template<typename T>vec<int>cpr(vec<T>x){auto lis=dedupe(x);map<T,int>mp;rep(i,len(lis))mp[lis[i]]=i;int n=len(x);vec<int>res(n);rep(i,n)res[i]=mp[x[i]];return res;}ll modpow(ll a,ll x,ll p){if(x==0)return 1;a%=p;if(x==1)return a;ll res=modpow(a,x/2,p);res=(res*res)%p;if(x&1)res=(res*a)%p;return res;}template<typename T>bool chmax(T&a, const T&b){if(a<b){a=b;return true;}return false;}template<typename T>bool chmin(T&a, const T&b){if(a>b){a=b;return true;}return false;}struct SPF{int MX;vec<int>spf;SPF(int n):MX(n){spf.resize(n+1);rep(i,n+1)spf[i]=i;range(i,2,n+1)if(spf[i]==i){srange(j,2*i,n+1,i)if(spf[j]==j)spf[j]=i;}} const bool isprime(int i){return(i>1)&&(spf[i]==i);} const int operator[](int i){return spf[i];} const vec<pair<ll,int>>factorize(ll x){vec<pair<ll,int>>res;if(x<=MX){while(x>1){int p=spf[x],cnt=0;while(x%p==0){x/=p;cnt++;}res.push_back({p,cnt});}return res;}if(x<=MX*MX){range(i,2,MX+1)if(isprime(i)){int cnt=0;while(x%i==0){x/=i;cnt++;}if(cnt)res.push_back({i,cnt});}if(x>1)res.push_back({x,1});return res;}range(i,2,x+1){if(1ll*i*i>x)break;int cnt=0;while(x%i==0){x/=i;cnt++;}if(cnt)res.push_back({i,cnt});}if(x>1)res.push_back({x,1});return res;}};struct Fac{vec<mint>d;Fac(int n):d(n+1){d[0]=1;range(i,1,n+1)d[i]=d[i-1]*i;}mint f(int n){return d[n];}mint c(int n,int r){if(r<0||r>n)return 0;return d[n]/(d[r]*d[n-r]);}};Fac fac=Fac(1.2e7);struct Poly{vec<mint>f;Poly():f(0){}Poly(int n):f(n){}Poly(mint n):f(1,n){}Poly(vec<mint>f_):f(f_){}int size() const{return len(f);}mint operator[](int idx) const{if(idx<0||idx>=len(f))return 0;return f[idx];}mint&operator[](int idx){if(len(f)<=idx)f.resize(idx+1);return f[idx];}Poly&operator=( const Poly&g){f=g.f;return*this;}Poly operator+( const Poly&g) const{int siz=max(size(),len(g));vec<mint>res(siz);rep(i,size())res[i]+=f[i];rep(i,len(g))res[i]+=g[i];return Poly{res};}Poly operator-( const Poly&g) const{int siz=max(len(f),len(g));vec<mint>res(siz);rep(i,len(f))res[i]+=f[i];rep(i,len(g))res[i]-=g[i];return res;}Poly operator*( const Poly&g) const{return Poly{convolution(f,g.f)};}void operator+=( const Poly&g){*this=*this+g;}void operator*=( const Poly&g){*this=*this*g;}void operator-=( const Poly&g){*this=*this-g;}Poly prefix(int mx) const{Poly res;res.f.assign(f.begin(),f.begin()+min(len(f),mx+1));return res;}Poly pow(ll n,int mx=-1) const{if(mx==-1)mx=n*len(f)+1;int c=0;while(f[c]==0)c++;if(c>0){if(n*c>mx)return Poly(0);Poly g;range(i,c,len(f))g[i-c]=f[i];Poly h=g.pow(n,mx-n*c);Poly res;rep(i,mx-n*c)res[i+n*c]+=h[i];return res;}return(Poly((mint)n)*log(mx+1)).exp(mx);}Poly diff() const{vec<mint>res(len(f)-1);range(i,1,len(f))res[i-1]=i*f[i];return res;}Poly integ() const{vec<mint>res(len(f)+1);rep(i,len(f))res[i+1]=(f[i]/(mint)(i+1)).val();return res;}Poly inv(int mx) const{int siz=1;while(siz<mx)siz<<=1;Poly res(f[0].inv());int cur=1;while(cur<siz){cur<<=1;Poly p=prefix(cur)*res;if(len(p)>cur+1)p.f.resize(cur+1);res*=Poly((mint)2)-p;if(len(res)>cur+1)res.f.resize(cur+1);}if(len(res)>mx+1)res.f.resize(mx+1);return res;}Poly log(int mx) const{Poly res=(inv(mx)*diff()).integ();if(len(res)>mx+1)res.f.resize(mx+1);return res;}Poly exp(int mx) const{int siz=1;while(siz<mx)siz<<=1;Poly res({1,0});int cur=1;while(cur<siz){cur<<=1;res*=Poly((mint)1)-res.log(cur)+prefix(cur);if(len(res)>cur+1)res.f.resize(cur+1);}return res;}};namespace poly{Poly mul(vector<Poly>&lis,int mx=1e9){auto cmp=[&](int a,int b){return len(lis[a])>len(lis[b]);};priority_queue<int,vector<int>,decltype(cmp)>q(cmp);rep(i,len(lis))q.push(i);while(len(q)>1){int f1=q.top();q.pop();int f2=q.top();q.pop();Poly f=lis[f1]*lis[f2];if(len(f)>mx+1)f.f.resize(mx+1);lis.push_back(move(f));q.push(len(lis)-1);}return move(lis[q.top()]);}Poly ipl(vec<pair<mint,mint>>lis){int n=len(lis);Poly res;rep(i,n){vec<Poly>polys;rep(j,n)if(i!=j)polys.push_back(Poly(vec<mint>{-lis[j].first,1}));Poly f=mul(polys);mint coeff=lis[i].second;rep(j,n)if(i!=j)coeff/=lis[j].first-lis[i].first;res+=Poly(coeff)*f;}return res;}};template<typename T>T op_add(T a,T b){return a+b;}template<typename T>T op_prod(T a,T b){return a*b;}template<typename T>T op_min(T a,T b){return min(a,b);}template<typename T>T op_max(T a,T b){return max(a,b);}template<typename T>using segtree_add=segtree_<T,op_add<T>>;template<typename T>using segtree_prod=segtree_<T,op_prod<T>>;template<typename T>using segtree_min=segtree_<T,op_min<T>>;template<typename T>using segtree_max=segtree_<T,op_max<T>>;mint bostan_mori(Poly f,Poly g,ll n){if(n==0)return f[0]/g[0];Poly g_=g;srange(i,1,len(g),2)g_[i]=-g_[i];f*=g_;g*=g_;Poly f2((len(f)>>1)+1),g2((len(g)>>1)+1);rep(i,len(g2))g2[i]=g[i<<1];if(n&1)rep(i,(len(f)+1)>>1)f2[i]=f[(i<<1)+1];else rep(i,(len(f))>>1)f2[i]=f[i<<1];return bostan_mori(f2,g2,n>>1);}template<typename T>vec<pair<int,T>>RLE(vec<T>a){vec<pair<int,T>>res;for(T i:a){if(len(res)>0&&res.back().second==i)res.back().first++;else res.push_back({1,i});}return res;}vec<int>dy={0,1,0,-1};vec<int>dx={1,0,-1,0};ll isqrt(ll x){ll sm=0,bg=3e9;while(bg-sm>1){ll mid=(sm+bg)/2;if(mid*mid>x)bg=mid;else sm=mid;}return sm;}struct frac{int p,q;frac(ll p_=0,ll q_=0):p(p_),q(q_){}bool operator<( const frac&other) const{return p*other.q<other.p*q;}bool operator<=( const frac&other) const{return p*other.q<=other.p*q;}};struct per_dsu{struct node{int l=-1,r=-1,x=-1;};int n,now=0;vec<node>pool;vec<int>roots;int build(int l,int r){if(r-l==1){pool.push_back({-1,-1,-1});return len(pool)-1;}int m=(l+r)/2,a=build(l,m),b=build(m,r);pool.push_back({a,b,0});return len(pool)-1;}int value(int k,int l,int r,int p) const{if(r-l==1)return pool[k].x;int m=(l+r)/2;return p<m?value(pool[k].l,l,m,p):value(pool[k].r,m,r,p);}int update(int k,int l,int r,int p,int x){int q=len(pool);pool.push_back(pool[k]);if(r-l==1){pool[q].x=x;return q;}int m=(l+r)/2;if(p<m)pool[q].l=update(pool[k].l,l,m,p,x);else pool[q].r=update(pool[k].r,m,r,p,x);return q;}int leader_at(int root,int a) const{int p=value(root,0,n,a);return p<0?a:leader_at(root,p);}explicit per_dsu(int n_):n(n_){assert(n>=0);roots.push_back(n?build(0,n):-1);}int time() const{return now;}void rollback(int t){assert(0<=t&&t<len(roots));now=t;}int leader(int a) const{assert(0<=a&&a<n);return leader_at(roots[now],a);}bool same(int a,int b) const{return leader(a)==leader(b);}int size(int a) const{int r=leader(a);return-value(roots[now],0,n,r);}int merge(int a,int b){assert(0<=a&&a<n&&0<=b&&b<n);int root=roots[now];a=leader_at(root,a);b=leader_at(root,b);if(a!=b){int sa=value(root,0,n,a),sb=value(root,0,n,b);if(sa>sb){swap(a,b);swap(sa,sb);}root=update(root,0,n,a,sa+sb);root=update(root,0,n,b,a);}roots.push_back(root);now=len(roots)-1;return a;}vec<vec<int>>groups() const{vec<int>ls(n),at(n,-1);int count=0;rep(i,n){ls[i]=leader(i);if(at[ls[i]]==-1)at[ls[i]]=count++;}vec<vec<int>>res(count);rep(i,n)res[at[ls[i]]].push_back(i);return res;}};template<typename S>struct wei_dsu{vec<int>p;vec<S>w;explicit wei_dsu(int n):p(n,-1),w(n,S{}){}int leader(int a){assert(0<=a&&a<len(p));if(p[a]<0)return a;int q=p[a];p[a]=leader(q);w[a]+=w[q];return p[a];}int merge(int u,int v,S x){assert(0<=u&&u<len(p)&&0<=v&&v<len(p));int a=leader(u),b=leader(v);S d=x+w[u]-w[v];if(a==b)return a;if(-p[a]<-p[b]){swap(a,b);d=-d;}p[a]+=p[b];p[b]=a;w[b]=d;return a;}bool same(int a,int b){return leader(a)==leader(b);}int size(int a){return-p[leader(a)];}pair<bool,S>diff(int u,int v){if(leader(u)!=leader(v))return{false,S{}};return{true,w[v]-w[u]};}vec<vec<int>>groups(){int n=len(p);vec<int>ls(n),at(n,-1);int count=0;rep(i,n){ls[i]=leader(i);if(at[ls[i]]==-1)at[ls[i]]=count++;}vec<vec<int>>res(count);rep(i,n)res[at[ls[i]]].push_back(i);return res;}};template<typename T>struct Pnt{T x,y;Pnt():x(){}Pnt(T x_,T y_):x(x_),y(y_){}};template<typename T>struct Line{Pnt<T>p1,p2;Line():p1(){}Line(Pnt<T>p1_,Pnt<T>p2_):p1(p1_),p2(p2_){}Line(T x1,T y1,T x2,T y2):p1(x1,y1),p2(x2,y2){}};template<typename T>T ccw(Pnt<T>p1,Pnt<T>p2,Pnt<T>p3){return(p2.x-p1.x)*(p3.y-p1.y)-(p2.y-p1.y)*(p3.x-p1.x);}template<typename T>int sgn(T x){return(x>0)-(x<0);}template<typename T>bool on_segment(Pnt<T>a,Pnt<T>b,Pnt<T>p){return ccw(a,b,p)==0&&min(a.x,b.x)<=p.x&&p.x<=max(a.x,b.x)&&min(a.y,b.y)<=p.y&&p.y<=max(a.y,b.y);}template<typename T>bool intersect(Line<T>l1,Line<T>l2,bool edge=false){auto a=l1.p1,b=l1.p2;auto c=l2.p1,d=l2.p2;if(sgn(ccw(a,b,c))*sgn(ccw(a,b,d))<0&&sgn(ccw(c,d,a))*sgn(ccw(c,d,b))<0){return true;}if(!edge)return false;return on_segment(a,b,c)||on_segment(a,b,d)||on_segment(c,d,a)||on_segment(c,d,b);}struct RConv{int n=0;vec<mint>f1,f2,f3;mint add_input(mint a,mint b){int k=n;n++,f1.push_back(a),f2.push_back(b);if(len(f3)<=k)f3.resize(k+1);if(k==0)f3[0]+=f1[0]*f2[0];else f3[k]+=f1[k]*f2[0],f3[k]+=f1[0]*f2[k];for(int p=1;2*p-1<=k;p<<=1){if(k%p!=p-1)continue;int l=k-p+1;vec<mint>x=slice(f1,l,p),y=slice(f2,p,p),z=convolution(x,y);int base=l+p;rep(i,len(z))add_to_f3(base+i,z[i]);if(l!=p){vec<mint>x=slice(f2,l,p),y=slice(f1,p,p),z=convolution(x,y);int base=l+p;rep(i,len(z))add_to_f3(base+i,z[i]);}}return f3[k];}private:void add_to_f3(int idx,mint v){if(len(f3)<=idx)f3.resize(idx+1);f3[idx]+=v;}vec<mint>slice( const vec<mint>&v,int l,int len){return vec<mint>(v.begin()+l,v.begin()+l+len);}};template<typename T>tuple<bool,T,T>extgcd(T a,T b){if(b==0)switch(a){case 1:return{true,1,0};case-1:return{true,-1,0};default:return{false,0,0};}auto[f,x,y]=extgcd(b,a%b);if(!f)return{false,0,0};return{true,y,x-(a/b)*y};}template<typename T>tuple<bool,T,T>linear_eq(T a,T b,T c){T g=gcd(a,b);if(c%g!=0)return{false,0,0};a/=g,b/=g,c/=g;auto[f,x,y]=extgcd(a,b);if(!f)return{false,0,0};return{true,x*c,y*c};}struct BFS{vec<vec<int>>G;BFS(vec<vec<int>>G_):G(move(G_)){}vec<int>dist(int s=0) const{assert(0<=s&&s<len(G));vec<int>d(len(G),-1);d[s]=0;queue<int>q;q.push(s);while(!q.empty()){int u=q.front();q.pop();for(int v:G[u])if(d[v]==-1){d[v]=d[u]+1;q.push(v);}}return d;}};template<typename S>struct Dijkstra{vec<vec<pair<S,int>> >G;Dijkstra(vec<vec<pair<S,int>> >G_):G(move(G_)){}vec<S>dist(int s=0) const{assert(0<=s&&s<len(G));S mx=(numeric_limits<S>::max)();vec<S>d(len(G),mx);d[s]=S{};priority_queue<pair<S,int>,vec<pair<S,int>>,greater<pair<S,int>> >q;q.push({S{},s});while(!q.empty()){auto[du,u]=q.top();q.pop();if(du!=d[u])continue;for(auto[w,v]:G[u])if(du<=mx-w&&d[v]>du+w){d[v]=du+w;q.push({d[v],v});}}return d;}};template<typename S>S MST(vec<vec<pair<S,int>> >G){if(G.empty())return S{};vec<bool>used(len(G));priority_queue<pair<S,int>,vec<pair<S,int>>,greater<pair<S,int>> >q;q.push({S{},0});S res{};int count=0;while(!q.empty()){auto[w,u]=q.top();q.pop();if(used[u])continue;used[u]=true;res+=w;count++;for(auto edge:G[u])if(!used[edge.second])q.push(edge);}return count==len(G)?res:(numeric_limits<S>::max)();}struct LCA{int n,lg=1;vec<int>depth;vec<vec<int>>up;LCA(vec<vec<int>>G,int r=0):n(len(G)),depth(n,-1){assert(n&&0<=r&&r<n);while((1LL<<lg)<=n)lg++;up.assign(lg,vec<int>(n,r));queue<int>q;q.push(r);depth[r]=0;while(!q.empty()){int u=q.front();q.pop();for(int v:G[u])if(depth[v]==-1){depth[v]=depth[u]+1;up[0][v]=u;q.push(v);}}range(k,1,lg)rep(v,n)up[k][v]=up[k-1][up[k-1][v]];}int lca(int a,int b) const{assert(0<=a&&a<n&&0<=b&&b<n);assert(depth[a]!=-1&&depth[b]!=-1);if(depth[a]<depth[b])swap(a,b);int d=depth[a]-depth[b];rep(k,lg)if(d>>k&1)a=up[k][a];if(a==b)return a;rrep(k,lg)if(up[k][a]!=up[k][b]){a=up[k][a];b=up[k][b];}return up[0][a];}};ll sfloor_sum(ll n,ll m,ll a,ll b){ll div,res=0;div=a/m-(a%m<0);res+=(n*(n-1))/2*div;a-=div*m;div=b/m-(b%m<0);res+=n*div;b-=div*m;return res+floor_sum(n,m,a,b);}template<typename S,typename T,typename U>struct triplet{S first;T second;U third;triplet(S x,T y,U z):first(x),second(y),third(z){};bool operator<(triplet<S,T,U>other) const{if(first!=other.first)return first<other.first;if(second!=other.second)return second<other.second;return third<other.third;}};template<typename S>
vec<S> vec<S>.reverse(){let c=self;reverse(all(c));return c;}template<typename S>
void vec<S>.sort(){std::sort(self.begin(),self.end());}template<typename S,typename F>
void vec<S>.sort(F f){std::sort(self.begin(),self.end(),f);}template<typename S,typename T>
void set<S>.remove(T&&x){self.erase(static_cast<S>(forward<T>(x)));}template<typename S>
void set<S>.add(S x){self.insert(x);}template<typename S,typename T>
void unordered_set<S>.add(T&&x){self.insert(static_cast<S>(forward<T>(x)));}template<typename S,typename T>
void unordered_set<S>.remove(T&&x){self.erase(static_cast<S>(forward<T>(x)));}template<typename S>
void vec<S>.append(S x){self.push_back(x);}template<typename S>
S vec<S>.pop(){S x=move(self.back());self.pop_back();return x;}template<typename S>
void deque<S>.appendleft(S x){self.push_front(x);}template<typename S>
void deque<S>.popleft(){self.pop_front();}template<typename S>
void deque<S>.append(S x){self.push_back(x);}template<typename S>
void deque<S>.pop(){self.pop_back();}template<typename S,typename Container,typename Compare>
void priority_queue<S,Container,Compare>.add(S value){self.push(move(value));}template<typename S,typename Container,typename Compare>
S priority_queue<S,Container,Compare>.pop(){S value=self.top();self.pop();return value;}
template<typename S>int vec<S>.index(const S&x) const{rep(i,len(self))if(self[i]==x)return i;kill;}
template<typename S>int vec<S>.bisect_left(const S&x) const{return lower_bound(all(self),x)-self.begin();}template<typename S>
int vec<S>.bisect_right(const S&x) const{return upper_bound(all(self),x)-self.begin();}
int str.index(char x){rep(i,len(self))if(self[i]==x)return i;kill;}template<typename S,typename F>requires invocable<F&,S>
auto vec<S>.map(F f){if constexpr(is_invocable_v<F&,S>){using T=decay_t<invoke_result_t<F&,S>>;vec<T>res;for(S i:self)res.push_back(f(i));return res;}else if constexpr(requires(S value){f(stoi(value));}){using T=decay_t<decltype(f(stoi(declval<S>())))>;vec<T>res;for(S i:self)res.push_back(f(stoi(i)));return res;}else{static_assert(is_invocable_v<F&,S>,"map function accepts neither the element nor stoi(element)");}}template<typename S,typename F>requires is_invocable_r_v<bool,F&,S>
vec<S> vec<S>.filter(F f) const{vec<S>res;res.reserve(self.size());for(S i:self)if(f(i))res.push_back(i);return res;}void solve();int main(){ios::sync_with_stdio(false);cin.tie(nullptr);cout<<fixed<<setprecision(15);
#ifdef LOCAL
int t;cin>>t;bool safe=true;print("==========");rep(i,t){debug_(" ","","Processing testcase ");debug_(" ","",i+1);debug("...");auto start=time();solve();auto end=time();ld diff=chrono::duration_cast<chrono::nanoseconds>(end-start).count();diff*=1e-6;if(diff>0.9*TL)safe=false;debug_(" ","","  time taken: ");debug_(" ","",(int)diff);debug("ms");print("==========");}debug("==========================");debug("Code execution successful!");if(!safe)debug("Warning: potential TLE");str s;if(cin>>s)throw runtime_error("Input not finished!");
#else
